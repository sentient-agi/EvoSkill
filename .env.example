# Copy to .env and fill in. The two leg launchers (scripts/ssbv2_leg.sh,
# scripts/tau3_leg_b2525.sh) read this file when the variables are not already
# exported (override the location with EVOSKILL_ENV_FILE). Nothing else does:
# the loop and the oracle builders read the environment directly.

# Solver models are dispatched through OpenRouter.
OPENROUTER_API_KEY=

# NOT the auth path for the AO or the evolver. Those run through the `claude`
# binary and require a subscription (`claude login`); quota_scope.py strips this
# variable out of every Claude-family child so the run cannot silently spend API
# credit behind the subscription quota gate (#307). Set it only if a solver model
# reaches Anthropic through a gateway.
ANTHROPIC_API_KEY=

# SpreadsheetBench v2 only: absolute path to your dataset checkout.
# EXPORT THIS IN YOUR SHELL — putting it here alone is not enough. Only the two
# leg launchers read this file, and `evoskill-loop` and scripts/make_ssbv2_oracle.py
# both refuse outright when SSBV2_ROOT is unset in the environment they run in.
# SSBV2_ROOT=/path/to/SpreadsheetBench-v2
